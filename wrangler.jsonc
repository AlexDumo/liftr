{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "liftr",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "routes": [
    {
      "pattern": "liftr.alexdumo.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://liftr.alexdumo.com"
  },
  "d1_databases": [
    {
      "binding": "DATABASE",
      "database_name": "liftr-db",
      "database_id": "63d1873e-a332-40a1-85b2-d62bd934a773",
      "migrations_dir": "drizzle"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "4390d8c771134be79e44605c824b7076"
    }
  ]
}
